#!/data/data/com.termux/files/usr/bin/bash
# opencode wrapper - termux-glibc loader + proot syscall emulation
# The wrapper shell must have libtermux-exec.so preloaded (Termux sessions
# normally do) so that exec of proot is delegated to the system linker.
# proot itself is started without LD_PRELOAD so it can run glibc code.

GLIBC_LIB="/data/data/com.termux/files/usr/glibc/lib"
TOOL_DATA_DIR="/data/data/com.termux/files/home/.local/share/core-termux-data/opencode"

if [ ! -f "$GLIBC_LIB/ld-linux-aarch64.so.1" ] || [ ! -f "$TOOL_DATA_DIR/opencode" ]; then
  echo "Error: termux-glibc or opencode binary not found" >&2
  echo "Run: pkg install glibc" >&2
  exit 1
fi

# proot with host rootfs for syscall translation
# Note: no -- separator, pass args directly after loader
exec env -u LD_PRELOAD proot -r / \
  -b /dev:/dev -b /proc:/proc -b /sys:/sys \
  -b "$GLIBC_LIB:/lib" \
  -b "/data/data/com.termux/files/usr/bin:/bin" \
  "$TOOL_DATA_DIR/opencode" "$@"
